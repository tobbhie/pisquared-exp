# Switch between Dobby or GPT-4o mini
LLM_PROVIDER=openrouter # fireworks for dobby
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/sentientfoundation/models/dobby-unhinged-llama-3-3-70b-new


# OpenRouter Configuration (for embeddings and direct LLM calls if needed)
OPENROUTER_API_KEY=

# Vector DB Configuration
VECTOR_DB_TYPE=qdrant
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=https://pi2.network,https://www.pi2.network

# Crawler Configuration
PI2_BASE_URL=https://pi2.network
CRAWLER_INTERVAL=86400000

# Cache Configuration
CACHE_TTL=3600000
MAX_CACHE_SIZE=1000

